# The agent that runs tasks created without an explicit provider: claude or codex.
DEFAULT_PROVIDER=claude
# Leave blank for automatic agent repository selection.
DEFAULT_REPO=
ACP_DATA_DIR=.acp
ACP_URL=http://127.0.0.1:8765
MAX_CONCURRENT_RUNS=1
RUN_TIMEOUT_SECONDS=1800
POLL_SECONDS=0.5

# Install and authenticate the CLI for the provider selected above.
CLAUDE_COMMAND=claude
CODEX_COMMAND=codex
# Blank model names use the provider CLI's configured default.
CLAUDE_MODEL=
CODEX_MODEL=

# Optional: one Linear workspace and team. All seven IDs must be distinct.
LINEAR_API_KEY=
LINEAR_WORKSPACE_ID=
LINEAR_TEAM_ID=
LINEAR_WEBHOOK_SECRET=
LINEAR_STATES_JSON={}
# Replace {} above with your team's IDs, using these exact keys:
# {"planning":"STATE_ID_1","todo":"STATE_ID_2","in_progress":"STATE_ID_3","waiting_on_input":"STATE_ID_4","ready_for_review":"STATE_ID_5","deploy":"STATE_ID_6","done":"STATE_ID_7"}

# Optional: signed GitHub webhooks and access to private PR review comments.
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# Optional colon-separated parent directories for automatic repository discovery.
# REPO_SEARCH_ROOTS=/Users/you/Documents:/Users/you/Projects
# App-managed Linear configuration in ACP_DATA_DIR/linear.json overrides LINEAR_* above.
